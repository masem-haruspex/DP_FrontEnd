# ---------------------------------------------------------------------------
# Template environment file. Copy to '.env.development' and adjust as needed:
#   cp .env.example .env.development
# NOTE: every VITE_* variable is inlined into the public client bundle at build
# time, so never put a secret here - these are visible to anyone loading the app.
# ---------------------------------------------------------------------------

VITE_AUTH_API_BASE_URL=http://localhost:8080
VITE_BASE_URL=http://localhost:5173
