import { useState } from 'react';
import './MainMenu.css';

interface MainMenuProps {
  onSinglePlayer: () => void;
  isInitializing?: boolean;
}

export default function MainMenu({ onSinglePlayer, isInitializing = false }: MainMenuProps) {
  const [showAbout, setShowAbout] = useState(false);

  return (
    <>
      <div className="menu-content">
        <h1 className="menu-title">Virtual Piano</h1>

        <nav className="menu-nav">
                    <button
            className="menu-item"
            onClick={onSinglePlayer}
            disabled={isInitializing}
          >
            {isInitializing ? (
              <span className="loading-text">Initializing Audio...</span>
            ) : (
              'Single Player'
            )}
          </button>
          <button className="menu-item" disabled>
            Multi Player
          </button>
          <button className="menu-item" disabled>
            Settings
          </button>
          <button className="menu-item" onClick={() => setShowAbout(true)}>
            About
          </button>
          <button className="menu-item" disabled>
            Login/Logout
          </button>
        </nav>
      </div>

      {showAbout && (
        <div className="modal-overlay" onClick={() => setShowAbout(false)}>
          <div className="about-modal" onClick={(e) => e.stopPropagation()}>
            <h2>About Us</h2>
            <div className="about-content">
              <p>
                Created with love by [Your Name] and [Coworker's Name].
                This virtual piano experience brings the magic of music
                to your fingertips in a serene 3D environment.
              </p>
              <p>
                We hope you enjoy playing as much as we enjoyed creating
                this ethereal musical journey.
              </p>
            </div>
            <button className="close-button" onClick={() => setShowAbout(false)}>
              Close
            </button>
          </div>
        </div>
      )}
    </>
  );
}
